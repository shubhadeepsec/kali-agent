# ── Target resolver ───────────────────────────────────────────────────────────

def _resolve_target(args: list[str]) -> str | None:
    if args:
        return args[0]
    engs = list(ENG_BASE.iterdir()) if ENG_BASE.exists() else []
    if not engs:
        warn("No engagements. Run: pskill init"); return None
    if len(engs) == 1:
        return engs[0].name
    if HAS_RICH:
        for i, e in enumerate(engs, 1):
            console.print(f"  [bold yellow]{i}[/] {e.name}")
        choice = Prompt.ask("Select target")
        try:
            return engs[int(choice)-1].name
        except Exception:
            return choice
    else:
        for i, e in enumerate(engs, 1): print(f"  {i}. {e.name}")
        choice = input("Select: ")
        try: return engs[int(choice)-1].name
        except Exception: return choice

