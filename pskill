DISPATCH = {
    "scope":       cmd_scope,
    "init":        cmd_init,
    "intel":       cmd_intel,
    "next":        cmd_next,
    "audit":       cmd_audit,
    "log":         cmd_log,
    "report":      cmd_report,
    "ingest":      cmd_ingest,
    "playbook":    cmd_playbook,
    "engagements": cmd_engagements,
}

def run_command_str(line: str) -> None:
    parts = line.strip().split()
    if not parts: return
    cmd, args = parts[0].lower(), parts[1:]
    if cmd in ("exit", "quit", "q"):
        raise SystemExit(0)
    if cmd in ("help", "?"):
        print_help(); return
    if cmd in DISPATCH:
        DISPATCH[cmd](args)
    else:
        err(f"Unknown command: [bold]{cmd}[/]  — type [yellow]help[/] for commands" if HAS_RICH
            else f"Unknown command: {cmd}  — type 'help'")

def interactive_repl() -> None:
    """Claude Code-style interactive REPL."""
    print_banner()

    if not HAS_RICH:
        while True:
            try:
                line = input("pskill › ").strip()
                if line: run_command_str(line)
            except (EOFError, KeyboardInterrupt):
                print(); break
        return

    # Status bar
    scope_ok = AUTH_FILE.exists() and "Confirmed in-scope? | yes" in AUTH_FILE.read_text()
    scope_txt = "[green]● scope OK[/]" if scope_ok else "[red]● no scope[/]"
    eng_count = len(list(ENG_BASE.iterdir())) if ENG_BASE.exists() else 0
    console.print(
        Panel(
            f"{scope_txt}   [dim]|[/]   [cyan]{eng_count} engagements[/]   [dim]|[/]   "
            "[dim]type [bold white]help[/] for commands, [bold white]exit[/] to quit[/]",
            border_style="dim",
            padding=(0, 2),
        )
    )
    console.print()

    # prompt_toolkit session
    completer = WordCompleter(list(COMMANDS.keys()) + SKILLS, ignore_case=True)
    style = Style.from_dict({
        "prompt":    "ansired bold",
        "": "ansiwhite",
    })
    session: PromptSession = PromptSession(
        history=FileHistory(str(HIST_FILE)),
        auto_suggest=AutoSuggestFromHistory(),
        completer=completer,
        style=style,
    )

    while True:
        try:
            line = session.prompt(
                [("class:prompt", " pskill "), ("", " › "), ("", " ")],
            ).strip()
        except (EOFError, KeyboardInterrupt):
            console.print("\n[dim]bye.[/]"); break
        if not line:
            continue
        try:
            run_command_str(line)
        except SystemExit:
            console.print("[dim]bye.[/]"); break
        except Exception as exc:
            err(f"Unexpected error: {exc}")

# ── Entry point ───────────────────────────────────────────────────────────────

def main() -> int:
    args = sys.argv[1:]

    # No args → interactive REPL
    if not args:
        interactive_repl()
        return 0

    cmd = args[0].lower()
    rest = args[1:]

    if cmd in ("-h", "--help", "help"):
        print_banner()
        print_help()
        return 0

    if cmd in DISPATCH:
        try:
            DISPATCH[cmd](rest)
        except Exception as exc:
            err(str(exc))
            return 1
        return 0

    err(f"Unknown command: {cmd}  —  run [bold]pskill help[/]" if HAS_RICH else f"Unknown: {cmd}")
    return 1


if __name__ == "__main__":
    sys.exit(main())
