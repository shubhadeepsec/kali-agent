               "--command", ns.command, "--result", ns.result,
               *(["--notes", ns.notes] if ns.notes else []))
    ok("Evidence logged")

def cmd_ingest(args: list[str]) -> None:
    """Ingest tool output."""
    if len(args) < 3:
        info("Usage: ingest <target> <nmap|httpx|nuclei|ffuf|swagger> <file>"); return
    target, tool_type, file_path = args[0], args[1], args[2]
    intel_file = eng_path(target) / "intel.json"
    if not intel_file.exists():
        err(f"No engagement for '{target}'. Run: init --target {target}"); return

    script_map = {
        "nmap":    (ROOT / "pentest-skill" / "scripts" / "intel.py",        [str(intel_file), "ingest-nmap", file_path]),
        "ffuf":    (ROOT / "pentest-skill" / "scripts" / "ingest_ffuf.py",  [str(intel_file), file_path]),
        "httpx":   (ROOT / "pentest-skill" / "scripts" / "ingest_httpx.py", [str(intel_file), file_path]),
        "nuclei":  (ROOT / "pentest-skill" / "scripts" / "ingest_nuclei.py",[str(intel_file), file_path]),
        "swagger": (ROOT / "pentest-skill" / "scripts" / "ingest_swagger.py",[str(intel_file), file_path]),
    }
    if tool_type not in script_map:
        err(f"Unknown tool type: {tool_type}"); return

    script, run_args = script_map[tool_type]
    ctx = spinner(f"Ingesting [bold]{tool_type}[/] output…")
    if ctx:
        with ctx:
            result = subprocess.run([sys.executable, str(script), *run_args],
                                    capture_output=True, text=True)
    else:
        result = subprocess.run([sys.executable, str(script), *run_args],
                                capture_output=True, text=True)
    if result.returncode == 0:
        ok(f"Ingested {tool_type} output into intel.json")
    else:
        err(result.stderr)

