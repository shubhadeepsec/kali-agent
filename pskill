def cmd_init(args: list[str]) -> None:
    """Initialize engagement → stores in ~/.pskill/engagements/<slug>/"""
    if not args:
        if HAS_RICH:
            target = Prompt.ask("[bold yellow]Target[/] (hostname/IP/domain)")
            mode   = Prompt.ask("[bold yellow]Mode[/]", choices=["bounty","vdp","lab","ctf"], default="bounty")
            skill  = Prompt.ask("[bold yellow]Primary skill[/]", default="web-recon")
        else:
            target = input("Target: ")
            mode = input("Mode [bounty]: ") or "bounty"
            skill = input("Primary skill [web-recon]: ") or "web-recon"
    else:
        # parse --target / --mode / --skill
        import argparse
        p = argparse.ArgumentParser()
        p.add_argument("--target", required=True)
        p.add_argument("--mode", default="bounty")
        p.add_argument("--skill", default="web-recon")
        ns, _ = p.parse_known_args(args)
        target, mode, skill = ns.target, ns.mode, ns.skill

    slug = slugify(target)
    dest = ENG_BASE / slug
    if dest.exists():
        warn(f"Engagement already exists: {dest}")
        return

    # Copy template
    template = ROOT / "pentest-skill" / "engagement" / "_template"
    if template.exists():
        shutil.copytree(template, dest)
    else:
        dest.mkdir(parents=True)
        (dest / "evidence.md").write_text(f"# Evidence — {target}\n\n")
        now = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
        base_intel = {
            "target": target, "mode": mode, "primary_skill": skill,
            "updated": now, "hosts": [], "ports": {}, "services": [],
            "endpoints": [], "tech": [], "params": [], "vulns": [],
            "done": [], "blocked": [], "notes": [f"Initialized {now}"], "waf": ""
        }
        (dest / "intel.json").write_text(json.dumps(base_intel, indent=2) + "\n")

    # Patch intel.json
    intel_path = dest / "intel.json"
    intel = json.loads(intel_path.read_text())
    now = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    intel.update({"target": target, "mode": mode, "primary_skill": skill,
                  "updated": now, "notes": [f"Engagement initialized {now}"]})
    intel_path.write_text(json.dumps(intel, indent=2) + "\n")

    ok(f"Engagement ready: [bold]{dest}[/]" if HAS_RICH else f"Engagement ready: {dest}")
    info(f"intel.json → {intel_path}")

def cmd_intel(args: list[str]) -> None:
    """View or update target intelligence."""
    if not args:
        # interactive: list engagements and pick one
        engs = list(ENG_BASE.iterdir()) if ENG_BASE.exists() else []
        if not engs:
            warn("No engagements found. Run: pskill init"); return
        if HAS_RICH:
            console.print("[bold yellow]Available engagements:[/]")
            for i, e in enumerate(engs):
                console.print(f"  [{i+1}] {e.name}")
            target = Prompt.ask("Select target name")
        else:
            target = input("Target: ")
    elif args[0] in ("--target", "-t"):
        target = args[1]; args = args[2:]
    else:
        target = args[0]; args = args[1:]

    intel = load_intel(target)
    if not intel:
        err(f"No intel.json for target '{target}'"); return

    if not args:
        _show_intel(target, intel)
    else:
        # delegate to intel.py script
        script = ROOT / "pentest-skill" / "scripts" / "intel.py"
        intel_file = eng_path(target) / "intel.json"
        run_script(script, str(intel_file), *args)

def _show_intel(target: str, intel: dict) -> None:
    if not HAS_RICH:
        print(json.dumps(intel, indent=2)); return

    grid = Table.grid(padding=(0, 2))
    grid.add_column(style="bold dim", no_wrap=True)
    grid.add_column()

    grid.add_row("Target",  f"[bold white]{intel.get('target','?')}[/]")
    grid.add_row("Mode",    f"[cyan]{intel.get('mode','?')}[/]")
    grid.add_row("Skill",   f"[yellow]{intel.get('primary_skill','?')}[/]")
    grid.add_row("Updated", f"[dim]{intel.get('updated','?')}[/]")
    if intel.get("waf"):
        grid.add_row("WAF/CDN", f"[red]{intel['waf']}[/]")

    def _list_section(title: str, items: list, style: str = "white") -> str:
        if not items: return "[dim]—[/]"
        return "\n".join(f"[{style}]• {i}[/]" for i in items[:10])

    grid.add_row("Hosts",     _list_section("Hosts",     intel.get("hosts", []),     "green"))
    grid.add_row("Endpoints", _list_section("Endpoints", intel.get("endpoints", []), "blue"))
    grid.add_row("Tech",      _list_section("Tech",      intel.get("tech", []),      "magenta"))

    vulns = intel.get("vulns", [])
    sev_color = {"critical":"bold red","high":"red","medium":"yellow","low":"green","info":"dim"}
    vuln_lines = "\n".join(
        f"[{sev_color.get(v.get('severity','info'),'white')}]• [{v.get('severity','?').upper()}] {v.get('title','?')}[/]"
        for v in vulns[:10]
    ) if vulns else "[dim]—[/]"
    grid.add_row("Vulns", vuln_lines)

    grid.add_row("Done",    f"[dim]{len(intel.get('done',[]))} actions[/]")

    console.print(Panel(grid, title=f"[bold red]Intel — {target}[/]",
                         border_style="red", padding=(1, 2)))

