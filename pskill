# ── Helpers ───────────────────────────────────────────────────────────────────

def slugify(s: str) -> str:
    s = re.sub(r"https?://", "", s.strip().lower())
    return re.sub(r"[^a-z0-9._-]+", "-", s).strip("-") or "target"

def load_intel(target: str) -> dict:
    path = ENG_BASE / slugify(target) / "intel.json"
    if not path.exists():
        return {}
    return json.loads(path.read_text())

def save_intel(target: str, intel: dict) -> None:
    path = ENG_BASE / slugify(target) / "intel.json"
    intel["updated"] = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    path.write_text(json.dumps(intel, indent=2) + "\n")

def eng_path(target: str) -> Path:
    return ENG_BASE / slugify(target)

def run_script(script: Path, *args: str) -> subprocess.CompletedProcess:
    return subprocess.run([sys.executable, str(script), *args],
                          capture_output=False, text=True)

