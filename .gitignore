# Local scope — may contain program URLs, targets, account notes
pentest-skill/AUTHORIZATION.md

# Engagement intel, evidence, creds — per-target local state
pentest-skill/engagement/*
!pentest-skill/engagement/_template/
!pentest-skill/engagement/_template/**

# Field journal entries may contain sensitive findings
pentest-skill/field-journal/*
!pentest-skill/field-journal/_template.md
!pentest-skill/field-journal/_index.md

# Python cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.code-workspace
